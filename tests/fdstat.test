#!/bin/bash

[ -f testing.sh ] && . testing.sh

#testing "name" "command" "result" "infile" "stdin"

# 옵션 검증 (지금도 통과해야 함)
testcmd "-n with PID" "-n 3 1 2>/dev/null || echo err" "err\n" "" ""
testcmd "-L without -d" "-L 2>/dev/null || echo err" "err\n" "" ""
testcmd "-w out of range" "-w 101 2>/dev/null || echo err" "err\n" "" ""
testcmd "-n zero" "-n 0 2>/dev/null || echo err" "err\n" "" ""
testcmd "-n with -U" "-n 3 -U 2>/dev/null || echo err" "err\n" "" ""
testcmd "-U with PID" "-U 1 2>/dev/null || echo err" "err\n" "" ""
testcmd "-l without PID" "-l 2>/dev/null || echo err" "err\n" "" ""
testcmd "-u without -n/-U" "-u root 2>/dev/null || echo err" "err\n" "" ""
testcmd "-c without -n/-U" "-c sh 1 2>/dev/null || echo err" "err\n" "" ""

# TODO(나주한): 시스템 모드 출력, -w 경고, -d 반복, -L 누수 감지
#   예: 셸에서 FD 를 하나씩 더 열면서 -d 1 -L 로 감지되는지 확인

# PID 모드 (B1)
# 테스트 명령은 서브셸에서 돌기 때문에 $$ 대신 $BASHPID 로 "지금 이 셸" 을 가리킨다.
# $(...) 안에서는 $BASHPID 가 또 다른 서브셸이 되므로 P 에 먼저 저장해 둔다.
# 상속받은 FD 수는 환경마다 다르므로 절대값 대신 FD 를 더 연 뒤의 "차이" 를 본다.
fdcol() { "$C" "$1" | awk -v c=$2 'NR==2{print $c}'; }

testing "header" "\"\$C\" \$BASHPID | head -n1" \
  "PID     COMMAND            FDS    LIMIT  USE%\n" "" ""
testing "PID column" "P=\$BASHPID; [ \$(fdcol \$P 1) = \$P ] && echo yes" \
  "yes\n" "" ""
testing "counts opened FDs" \
  "P=\$BASHPID; A=\$(fdcol \$P 3); exec 7</dev/null 8</dev/null 9</dev/null;
   B=\$(fdcol \$P 3); exec 7<&- 8<&- 9<&-; echo \$((B-A))" "3\n" "" ""
testing "header once for many PIDs" "\"\$C\" \$BASHPID \$BASHPID | wc -l" \
  "3\n" "" ""
testcmd "no such process" "999999999 2>/dev/null || echo err" "err\n" "" ""
testcmd "bad PID" "12ab 2>/dev/null || echo err" "err\n" "" ""
testcmd "bad PID still shows others" "abc \$BASHPID 2>/dev/null | wc -l" \
  "2\n" "" ""

# -t 종류 분류 (B1)
# tcount PID 종류: -t 셋째 줄에서 "종류 개수" 의 개수 (없으면 0)
tcount() {
  "$C" -t "$1" | awk -v t=$2 'NR==3{for(i=1;i<NF;i++) if($i==t) n=$(i+1)}
    END{print n+0}'
}

testing "-t dev" "P=\$BASHPID; A=\$(tcount \$P dev); exec 7</dev/null;
  B=\$(tcount \$P dev); exec 7<&-; echo \$((B-A))" "1\n" "" ""
testing "-t pipe" "P=\$BASHPID; A=\$(tcount \$P pipe); exec 7< <(:);
  B=\$(tcount \$P pipe); exec 7<&-; echo \$((B-A))" "1\n" "" ""
testing "-t file" "P=\$BASHPID; A=\$(tcount \$P file); exec 7<\"\$C\";
  B=\$(tcount \$P file); exec 7<&-; echo \$((B-A))" "1\n" "" ""
testing "no -t no breakdown" "\"\$C\" \$BASHPID | wc -l" "2\n" "" ""

# 소켓·anon_inode 는 셸로 만들 수 없어 python3 으로 만든다 (없으면 건너뜀)
PYFD='import os, sys, socket, select, subprocess, ctypes
L = ctypes.CDLL(None)
keep = [select.epoll(), os.eventfd(0), L.inotify_init(), L.timerfd_create(1, 0),
  L.signalfd(-1, (ctypes.c_ulong*16)(), 0), socket.socketpair()]
t = socket.socket(); t.bind(("127.0.0.1", 0)); t.listen()
u = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); u.bind(("127.0.0.1", 0))
n = socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, 0); n.bind((0, 0))
out = subprocess.run([sys.argv[1], "-t", str(os.getpid())],
  capture_output=True, text=True).stdout.split("\n")[2].split()[::2]
want = "tcp udp unix netlink eventfd epoll inotify timerfd signalfd".split()
print(" ".join(w for w in want if w in out))'
[ -z "$(command -v python3)" ] && SKIP=1
testing "-t sockets and anon_inodes" "python3 -c \"\$PYFD\" \"\$C\"" \
  "tcp udp unix netlink eventfd epoll inotify timerfd signalfd\n" "" ""

# -n 상위 N개 (B1). 읽을 수 없는 프로세스 안내는 stderr 라 2>/dev/null 로 버린다.
testing "-n 1 one row" "\"\$C\" -n 1 2>/dev/null | wc -l" "2\n" "" ""
testing "-n sorted" "\"\$C\" -n 50 2>/dev/null |
  awk 'NR>1{if(p!=\"\" && \$3>p) b=1; p=\$3} END{print b ? \"no\" : \"yes\"}'" \
  "yes\n" "" ""
# FD 600개를 연 프로세스를 띄워 Top 5 안에 들어오는지 (마지막 FD 가 생길 때까지 대기)
testing "-n finds busy process" \
  "(for i in \$(seq 10 609); do eval \"exec \$i</dev/null\"; done; exec sleep 30) &
   P=\$!; until [ -e /proc/\$P/fd/609 ]; do :; done
   \"\$C\" -n 5 2>/dev/null | awk -v p=\$P '\$1==p && \$3>=600{print \"found\"}'
   kill \$P" "found\n" "" ""
testing "-n with -t" "\"\$C\" -n 1 -t 2>/dev/null | wc -l" "3\n" "" ""

# TODO(김건우): -l 출력 형식, -u/-c 필터, -U 사용자별 합계

# A1: 시스템 통계 출력 확인
testing "A1 system fields" \
  '"$C" | grep -Ec "^(Allocated|Unused|In use|Max|file-max|nr_open):"' \
  "6\n" "" ""

# A1: FD 한도 초과 경고 확인
testing "A1 warning" \
  '(ulimit -n 32; P=$BASHPID; "$C" -w 1 "$P" 2>&1 | grep -q "WARNING:" && echo yes)' \
  "yes\n" "" ""

# A1: 반복 모니터링 변화량 출력 확인
testing "A1 monitoring" \
  'timeout 4s "$C" -d 1 | grep -c "^Change:" | awk '\''$1 >= 2 {print "yes"}'\''' \
  "yes\n" "" ""

# A1: FD 누수 의심 감지 자동화 테스트
fdstat_leak_test()
{
  local pid result

  # FD를 조금씩 늘리는 테스트 프로세스 생성
  bash -c 'sleep 0.5; for fd in {3..24}; do
    eval "exec $fd</dev/null"
    sleep 0.2
  done; sleep 3' &
  pid=$!

  # 누수 의심 경고 발생 여부 확인
  result=$(timeout 5s "$C" -d 1 -L "$pid" 2>/dev/null)

  # 테스트 프로세스 정리
  kill "$pid" 2>/dev/null
  wait "$pid" 2>/dev/null

  if [[ "$result" == *"POSSIBLE FD LEAK:"* ]]; then
    echo yes
  else
    echo no
  fi
}

testing "A1 leak detection" \
  "fdstat_leak_test" "yes\n" "" ""
